# Copy this file to `.env` and fill in the values for your own backend.
# These are build-time values: run `npm run build` again after changing them.
#
# All three come from your Supabase project (hosted or self-hosted).
# The publishable/anon key is safe to ship in the browser — row level security
# protects your data. NEVER put the service_role key in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
